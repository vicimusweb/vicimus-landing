---
import { dict, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
---
<section id="services" class="relative border-t border-border">
  <div class="mx-auto max-w-content px-6 md:px-10 py-20 md:py-32">
    <p data-animate class="font-mono text-xs uppercase tracking-widest text-muted mb-6">
      {t.services.eyebrow}
    </p>
    <h2
      data-animate
      class="font-medium text-text max-w-3xl"
      style="font-size: clamp(2rem, 4.5vw, 3.75rem); letter-spacing: -0.03em; line-height: 1.1;"
    >
      {t.services.heading}
    </h2>
    <p data-animate class="mt-8 max-w-2xl text-muted leading-relaxed">
      {t.services.intro}
    </p>

    <ol data-animate class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-px bg-border border border-border">
      {t.services.items.map((item, i) => (
        <li class="bg-bg p-8 md:p-10 flex flex-col gap-4">
          <span class="font-mono text-xs uppercase tracking-widest text-accent">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="font-medium text-text" style="font-size: clamp(1.25rem, 2vw, 1.625rem); letter-spacing: -0.02em; line-height: 1.2;">
            {item.title}
          </h3>
          <p class="text-muted leading-relaxed">
            {item.body}
          </p>
        </li>
      ))}
    </ol>

    <ul data-animate class="mt-16 flex flex-wrap gap-3">
      {t.services.capabilities.map((cap) => (
        <li class="font-mono text-xs uppercase tracking-widest text-muted px-4 py-2 border border-border rounded-full">
          [ {cap} ]
        </li>
      ))}
    </ul>
  </div>
</section>
