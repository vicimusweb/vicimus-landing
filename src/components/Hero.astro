---
import { dict, type Locale } from '../i18n/utils';
import GradientOrb from './GradientOrb.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
---
<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <GradientOrb />

  <div class="relative z-10 mx-auto max-w-content w-full px-6 md:px-10 py-32 text-center">
    <p data-animate class="font-mono text-xs uppercase tracking-widest text-accent mb-8" style="transition-delay: 0ms;">
      {t.hero.eyebrow}
    </p>
    <h1
      data-animate
      class="font-medium text-text mx-auto max-w-5xl"
      style="font-size: clamp(3rem, 8vw, 7rem); letter-spacing: -0.04em; line-height: 1.05; transition-delay: 120ms;"
    >
      {t.hero.headline}
    </h1>
    <p data-animate class="mt-8 mx-auto max-w-2xl text-base md:text-lg text-muted leading-relaxed" style="transition-delay: 240ms;">
      {t.hero.subheadline}
    </p>
    <div data-animate class="mt-12" style="transition-delay: 360ms;">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent text-bg font-medium text-sm transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_32px_rgba(163,230,53,0.4)]"
      >
        {t.hero.cta}
      </a>
    </div>
  </div>

  <a
    href="#about"
    aria-label={t.hero.scrollHint}
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 text-muted hover:text-text transition-colors"
  >
    <span class="block font-mono text-xs uppercase tracking-widest animate-pulse">
      {t.hero.scrollHint} ↓
    </span>
  </a>
</section>
