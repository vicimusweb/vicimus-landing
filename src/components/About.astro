---
import { dict, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
---
<section id="about" class="relative border-t border-border">
  <div class="mx-auto max-w-content px-6 md:px-10 py-20 md:py-32">
    <p data-animate class="font-mono text-xs uppercase tracking-widest text-muted mb-6">
      {t.about.eyebrow}
    </p>
    <h2
      data-animate
      class="font-medium text-text max-w-3xl"
      style="font-size: clamp(2rem, 4.5vw, 3.75rem); letter-spacing: -0.03em; line-height: 1.1;"
    >
      {t.about.heading}
    </h2>
    <div data-animate class="mt-10 max-w-[700px] space-y-6 text-muted leading-relaxed">
      <p>{t.about.p1}</p>
      <p>{t.about.p2}</p>
    </div>

    <p data-animate class="mt-20 font-mono text-xs uppercase tracking-widest text-muted">
      {t.about.valuesLabel}
    </p>
    <dl data-animate class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 max-w-4xl">
      {t.about.values.map((v, i) => (
        <div class="flex gap-4 border-t border-border pt-6">
          <span class="font-mono text-xs uppercase tracking-widest text-accent pt-1">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <dt class="text-text font-medium" style="letter-spacing: -0.01em;">{v.title}</dt>
            <dd class="mt-2 text-muted leading-relaxed">{v.body}</dd>
          </div>
        </div>
      ))}
    </dl>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-px bg-border border border-border">
      {t.about.stats.map((s) => (
        <div data-animate class="bg-bg p-8 md:p-10">
          <div data-stat-target={s.value} class="text-4xl md:text-5xl font-medium text-text" style="letter-spacing: -0.03em;">
            {s.value}
          </div>
          <div class="mt-3 font-mono text-xs uppercase tracking-widest text-muted">
            {s.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    const stats = document.querySelectorAll<HTMLElement>('[data-stat-target]');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        const target = el.dataset.statTarget ?? '';
        const match = /^(\d+)(.*)$/.exec(target);
        if (!match) continue;
        const num = parseInt(match[1], 10);
        const suffix = match[2];
        const duration = 1400;
        const start = performance.now();
        el.textContent = `0${suffix}`;
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = `${Math.round(num * eased)}${suffix}`;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        io.unobserve(el);
      }
    }, { threshold: 0.5 });
    stats.forEach((s) => io.observe(s));
  });
</script>
