---
interface Props {
  ariaLabel: string;
}
const { ariaLabel } = Astro.props;
const mapSrc = 'https://www.google.com/maps?q=Bucuresti+Strada+Nerva+Traian+27-33&output=embed';
---
<div class="map-wrap relative border border-border rounded-md overflow-hidden bg-surface" data-map-src={mapSrc}>
  <div class="map-placeholder aspect-[16/10] w-full flex items-center justify-center text-muted font-mono text-xs uppercase tracking-widest">
    <span>București · Str. Nerva Traian nr. 27-33</span>
  </div>
  <iframe
    class="map-iframe absolute inset-0 w-full h-full opacity-0 transition-opacity duration-700"
    title={ariaLabel}
    aria-label={ariaLabel}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    style="filter: invert(0.92) hue-rotate(180deg); border: 0;"
  ></iframe>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const wraps = document.querySelectorAll<HTMLElement>('.map-wrap');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const wrap = entry.target as HTMLElement;
          const iframe = wrap.querySelector<HTMLIFrameElement>('.map-iframe');
          const src = wrap.dataset.mapSrc;
          if (iframe && src && !iframe.src) {
            iframe.src = src;
            iframe.addEventListener('load', () => {
              iframe.style.opacity = '1';
            }, { once: true });
          }
          io.unobserve(wrap);
        }
      },
      { rootMargin: '200px' }
    );
    wraps.forEach((w) => io.observe(w));
  });
</script>
